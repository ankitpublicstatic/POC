Direct answer: below is a ready, minimal Dockerfile that builds a Python+Chrome+ChromeDriver image suitable for running pytest + Selenium in CI (headless by default). I also give a recommended image tag to base on, build/run instructions, and notes about maintenance and common pitfalls.

Dockerfile (minimal Python + Chrome + ChromeDriver)

Save as Dockerfile at your repo root.

text
# Dockerfile
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    CHROME_VERSION=stable \
    CHROMEDRIVER_VERSION=auto

# Install OS deps needed by Chrome and Selenium
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgdk-pixbuf2.0-0 \
    libnspr4 \
    libnss3 \
    libx11-6 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    lsb-release \
    wget \
    gnupg \
    unzip \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install Google Chrome (stable)
RUN wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | apt-key add - \
 && echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends google-chrome-stable \
 && rm -rf /var/lib/apt/lists/*

# Install chromedriver that matches installed Chrome
# If CHROMEDRIVER_VERSION=auto, we fetch matching chromedriver for installed chrome
RUN set -eux; \
 CHROME_BIN=$(google-chrome-stable --version | awk '{print $3}' | cut -d. -f1-3); \
 if [ "${CHROMEDRIVER_VERSION}" = "auto" ]; then \
   CDVER=$(wget -qO- "https://chromedriver.storage.googleapis.com/LATEST_RELEASE_${CHROME_BIN}"); \
 else \
   CDVER="${CHROMEDRIVER_VERSION}"; \
 fi; \
 wget -q -O /tmp/chromedriver.zip "https://chromedriver.storage.googleapis.com/${CDVER}/chromedriver_linux64.zip"; \
 unzip -q /tmp/chromedriver.zip -d /usr/local/bin/; \
 chmod +x /usr/local/bin/chromedriver; \
 rm /tmp/chromedriver.zip

# Create app directory
WORKDIR /app

# Install Python deps (expect a requirements.txt in repo)
COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip \
 && pip install -r /app/requirements.txt

# Copy project
COPY . /app

# Default env for headless execution (tests should still set options, but keep these)
ENV PYTHONUNBUFFERED=1 \
    DISPLAY=:99

# Default command: run pytest (override in CI)
CMD ["pytest", "-q"]
