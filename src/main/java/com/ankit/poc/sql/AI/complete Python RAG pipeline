## ⚙️ 2️⃣  Terraform module: `grafana_provision.tf`

Below example assumes you’re using **Grafana Cloud or Grafana Enterprise** with the Terraform provider.

```hcl
terraform {
  required_providers {
    grafana = {
      source  = "grafana/grafana"
      version = "~> 2.10"
    }
  }
}

provider "grafana" {
  url  = var.grafana_url
  auth = var.grafana_api_key
}

# 1️⃣ Create a webhook contact point that points to the alert Lambda
resource "grafana_contact_point" "slack_webhook" {
  name = "Slack Alerts"
  type = "webhook"

  settings = jsonencode({
    url = var.grafana_alert_webhook_url
    httpMethod = "POST"
    disableResolveMessage = false
  })
}

# 2️⃣ Define an alert rule for CPU usage
resource "grafana_rule_group" "cpu_rule_group" {
  name      = "RAG-Service CPU Rules"
  folder    = "RAG-Metrics"
  interval  = "1m"

  rule {
    name   = "High CPU Utilization"
    for    = "5m"
    no_data_state = "NoData"
    exec_err_state = "Error"

    condition {
      evaluator = "gt"
      threshold = 80
      operator  = "and"
    }

    query {
      ref_id = "A"
      datasource_uid = var.grafana_datasource_uid
      model = jsonencode({
        refId   = "A"
        expr    = "avg(node_cpu_usage{job='rag-service'})"
        legend  = "{{instance}}"
      })
    }

    notification {
      uid = grafana_contact_point.slack_webhook.uid
    }

    label {
      key   = "service"
      value = "RAG-Service"
    }

    annotation {
      key   = "summary"
      value = "CPU utilization above 80% for 5 minutes"
    }
  }
}
```

