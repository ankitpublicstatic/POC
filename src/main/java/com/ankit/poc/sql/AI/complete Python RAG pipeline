            info = requests.get(f"https://huggingface.co/api/models/{name}", timeout=20).json()
            out = f"{BASE}/ai_hf/{name.replace('/', '_')}.json"
            json.dump(info, open(out, "w"), indent=2)
            print("✔ API metadata", name)
    except Exception as e:
        print("⚠️", name, e)

