Example production-style code:

java
// src/main/java/com/acme/shop/product/ProductService.java
package com.acme.shop.product;

import java.math.BigDecimal;
import java.util.List;
import org.springframework.stereotype.Service;

@Service
public class ProductService {
    private final ProductRepository repository;

    public ProductService(ProductRepository repository) {
        this.repository = repository;
    }

    public List<Product> findAvailableProducts() {
        return repository.findByActiveTrue();
    }

    public Product create(CreateProductRequest request) {
        if (repository.existsBySku(request.sku())) {
            throw new DuplicateSkuException(request.sku());
        }

        Product product = new Product(
            request.sku(),
            request.name().trim(),
            request.price(),
            true
        );

        return repository.save(product);
    }
}

record CreateProductRequest(
    String sku,
    String name,
    BigDecimal price
) {}

Test it so JaCoCo has meaningful coverage:

java
// src/test/java/com/acme/shop/product/ProductServiceTest.java
package com.acme.shop.product;

import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.mockito.Mockito.*;

import java.math.BigDecimal;
import org.junit.jupiter.api.Test;

class ProductServiceTest {

    @Test
    void rejectsDuplicateSku() {
        ProductRepository repository = mock(ProductRepository.class);
        when(repository.existsBySku("SKU-1")).thenReturn(true);

        ProductService service = new ProductService(repository);

        assertThrows(
            DuplicateSkuException.class,
            () -> service.create(
                new CreateProductRequest("SKU-1", "Coffee", new BigDecimal("9.99"))
            )
        );

        verify(repository, never()).save(any());
    }
}

